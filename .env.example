# PostgreSQL-Verbindung aus dem Datenbank-Dashboard.
# Auf Render DATABASE_URL mit der Internal Database URL der Render-Datenbank setzen.
# Lokal die External Database URL verwenden; die Internal URL ist nur im Render-Netzwerk erreichbar.
# Die App verwendet TLS, akzeptiert aber Render-Postgres' selbstsigniertes Zertifikat.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Lokales PostgreSQL-Beispiel
# DATABASE_URL=postgres://user:pass@localhost:5432/actracker

# Twitch-App (https://dev.twitch.tv/console/apps): Live-Status aller bekannten Streamer direkt von Twitch (auch ohne Server),
# Zuschauerzahlen und VOD-Links an Toden und Stream-Ereignissen. Leer = Live-Status nur aus der Haupt-API, keine VOD-Links.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Twitch-IRC für Abo-Benachrichtigungen (optional; Twitch-OAuth-Token mit chat:read empfohlen).
# Alle bekannten Kanäle werden mit maximal 20 JOINs pro 10 Sekunden (einer alle 500 ms) abonniert.
# TWITCH_IRC_NICK=
# TWITCH_IRC_TOKEN=

# Geheimnis für /api/cron/poll (z. B. mit `openssl rand -hex 32` erzeugen).
# CRON_SECRET=

# Nur ohne AFK-Zähler der Quelle: Minuten ohne Streckenzuwachs, bevor Online-Spieler als AFK gelten (Standard: 5, wie der Server).
# CA_AFK_MINUTES=5

# Betriebsmodus: all (Standard, Website + Tracker), web (nur Website) oder tracker (nur Poller, Seiten liefern 503).
# TRACKER_MODE=all
