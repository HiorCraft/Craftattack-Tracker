{
  "name": "actracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "TRACKER_MODE=web next dev",
    "dev:tracker": "TRACKER_MODE=tracker next dev",
    "build": "next build",
    "start": "node --max-old-space-size=280 --max-semi-space-size=16 ./node_modules/next/dist/bin/next start",
    "start:web": "TRACKER_MODE=web npm start",
    "start:tracker": "TRACKER_MODE=tracker npm start",
    "start:cached": "TRACKER_MODE=web node scripts/cached-server.mjs",
    "build:schaetzung": "CA_ESTIMATE=1 next build",
    "start:schaetzung": "CA_ESTIMATE=1 TRACKER_MODE=web node --max-old-space-size=320 --max-semi-space-size=16 ./node_modules/next/dist/bin/next start",
    "schaetzung": "node scripts/estimate.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "d3-delaunay": "6.0.4",
    "fetch-socks": "^1.3.3",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  }
}
